# =============================================================
# Stop Being Prey — environment configuration
# Copy to .env.local for development; set the REQUIRED-IN-PROD
# vars in your hosting platform (Vercel) for production.
# =============================================================

# === Core / required in production =====================

# Public site URL used for Stripe success/cancel redirects, OG images,
# email links. Local dev: http://localhost:3000. Prod: https://stopbeingprey.com.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# JWT signing secret for member sessions and magic links. Generate with:
#   openssl rand -base64 32
# REQUIRED IN PRODUCTION. Members cannot sign in without this.
AUTH_SECRET=

# The editor / author / admin email. Used for: admin-gating the comments
# admin queue, the case-files admin notifications, the request-link admin
# bypass, the AUTHOR badge logic. REQUIRED IN PRODUCTION.
ADMIN_EMAIL=clay@stopbeingprey.com

# The Guild Host (Trish). A scoped helper role — NOT full admin. Grants the
# HOST byline chip, the ability to pin the Question of the Week, and access to
# the /guild/host panel to send the weekly note to paid members via Kit.
# Cannot delete, restore, or mark-read. Leave blank to disable the role.
GUILD_HOST_EMAIL=

# Address used as the "from" on transactional emails (Resend).
# Must be on a Resend-verified sending domain. Example:
#   EMAIL_FROM=Stop Being Prey <noreply@stopbeingprey.com>
EMAIL_FROM=

# === Stripe ============================================

# Stripe secret API key. Server-only, never expose.
# Use sk_test_* in dev, sk_live_* in prod.
# REQUIRED IN PRODUCTION.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Stripe Webhook signing secret. From the Stripe Dashboard webhook
# endpoint config. REQUIRED IN PRODUCTION — without it the webhook
# rejects all events and members are never created after payment.
STRIPE_WEBHOOK_SECRET=

# Stripe Product ID for the membership. Create one product in Stripe
# Dashboard ("Stop Being Prey Membership") and paste its id here
# (prod_XXXX). REQUIRED IN PRODUCTION — checkout refuses to run
# without it (the inline product_data fallback only works in dev).
STRIPE_MEMBERSHIP_PRODUCT_ID=

# === Redis (Upstash) — required for auth, comments, walls ====

# Upstash Redis REST endpoint + token. Stores magic-link tokens,
# member records, comments, donations, notifications, and all other
# mutable state. REQUIRED IN PRODUCTION.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Email (Resend) ====================================

# Resend API key. Required in production to send magic links,
# pending-comment notifications, payment-failed emails, case-review
# confirmations. Without it, emails are logged to the server console
# (dev only). REQUIRED IN PRODUCTION.
RESEND_API_KEY=

# Where editorial / letter submissions land. Defaults to ADMIN_EMAIL
# but configurable if you want them split.
EDITORIAL_EMAIL=clay@stopbeingprey.com

# The "from" address used by Resend when sending letter submissions.
# Must be on a Resend-verified sending domain.
LETTERS_FROM_ADDRESS=

# === Admin (dev-only) ==================================

# HTTP Basic Auth password for /admin/* in local dev.
# In production, /admin/* returns 404 (admin only runs on localhost).
# Set this in .env.local for development; leave unset in prod.
ADMIN_PASSWORD=

# === Kit (formerly ConvertKit) — optional ==============

# Kit V4 API key. Server-only. Used to tag subscribers + new members.
# Account → Advanced → "API Key" (NOT "API Secret" — V4 uses the Key).
# Optional: if unset, the kit integration soft-fails.
KIT_API_KEY=

# Kit tag id for the "Members" tag. Applied when a checkout completes.
KIT_MEMBERS_TAG_ID=

# Kit tag id for "Notify me when the book ships" sign-ups.
KIT_BOOK_NOTIFY_TAG_ID=

# === Analytics — optional ==============================

# Google Analytics 4 measurement ID. Set in Vercel env vars for
# production. Do NOT commit a real ID to .env.example.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# === Optional / feature-specific =======================

# Vercel Blob storage token for admin voice memo uploads.
# Optional; without it, voice-memo upload is disabled.
BLOB_READ_WRITE_TOKEN=

# OpenAI API key for audio transcription (admin voice memos).
# Optional; without it, transcription is disabled.
OPENAI_API_KEY=

# OpenRouter API key for screenshot analysis (case-file ingestion).
# Optional; without it, screenshot analysis is disabled.
OPENROUTER_API_KEY=

# Public site URL used by the screenshot-analyze user-agent string.
# Falls back to NEXT_PUBLIC_BASE_URL if unset.
NEXT_PUBLIC_SITE_URL=

# === Dev-only conveniences =============================
# These should NEVER be set in production. They short-circuit the
# Stripe membership check so any email can sign in.

# Set to 1 to grant any signed-in email an "active member" status
# (and auto-create a MemberRecord on first sign-in). Useful for
# exercising the auth + comments + chrome flow without Stripe.
DEV_AUTO_GRANT=

# Tier assigned to the auto-grant record. One of:
#   founder | regular | hunter | operator | apex
# Default: regular.
DEV_AUTO_GRANT_TIER=
